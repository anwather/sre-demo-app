{
  "Storage": {
    "AccountUrl": "",
    "ContainerName": "operations",
    "MaxRetries": 3,
    "RetryDelayMs": 200,
    "NetworkTimeoutSeconds": 10
  },
  "FaultInjection": {
    "LatencyEnabled": false,
    "LatencyMinMs": 0,
    "LatencyMaxMs": 0,
    "HttpErrorRate": 0.0,
    "HttpErrorStatusCode": 503,
    "StorageErrorRate": 0.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Azure.Core": "Warning"
    }
  },
  "AllowedHosts": "*"
}
